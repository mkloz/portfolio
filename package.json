{
  "name": "mkloz-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && npm run discovery:verify",
    "preview": "vite preview --port 3000",
    "lint": "eslint --quiet --cache --report-unused-disable-directives src/**/*.{ts,tsx,js,jsx}",
    "lint:fix": "eslint --fix --quiet --cache --report-unused-disable-directives src/**/*.{ts,tsx,js,jsx}",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high",
    "discovery:verify": "node scripts/discovery/verify.mjs",
    "pages:dev": "wrangler pages dev dist",
    "deploy:preview": "wrangler pages deploy dist --project-name mkloz-portfolio",
    "deploy:production": "wrangler pages deploy dist --project-name mkloz-portfolio --branch main",
    "smoke:deployment": "node scripts/deployment/smoke.mjs",
    "check:changed": "node scripts/quality/changed.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:release": "npm run check && npm run audit:security && npm run build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tailwindcss/vite": "^4.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.479.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "7.18.2",
    "react-router-hash-link": "^2.4.3",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.10",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.23",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-router-hash-link": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^8.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.1",
    "postcss": "^8.4.47",
    "prettier": "^3.2.4",
    "tailwind-scrollbar": "^4.0.1",
    "typescript": "5.2.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
